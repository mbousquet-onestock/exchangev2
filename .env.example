# Server-side only (Vercel project settings → Environment Variables, or .env.local for `npm run dev`).
# Settings API of the Extensions app, where the app settings and the OneStock credentials are stored.
SETTINGS_API_URL=https://extensions-lemon.vercel.app/api/settings
SETTINGS_API_KEY=
# Optional: decrypts enc:v1: values locally when the Settings API cannot (same value as the Extensions app).
SETTINGS_ENCRYPTION_KEY=
# extension_id of this app's settings ("*" settings are read too).
SETTINGS_EXTENSION_ID=exchange
